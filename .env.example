#  BITCOIN PUZZLE SOLVER CONFIGURATION
#  Rename this file to .env before running

#==============================================

# NETWORK CONFIGURATION
# The Port the server listens on
PORT=3000
# The IP address of the Orchestrator (Server)
SERVER_IP=192.168.1.100
# The subnet prefix to allow connections from (e.g., 10.42. for Pi hotspot which is 10.42.0.1 by defualt)
ALLOWED_IP_PREFIX=192.168.1.

# HARDWARE & RIG CONFIGURATION
# MAC Address of the mining rig (for Wake-on-LAN)
RIG_MAC_ADDRESS=00:11:22:33:44:55
# Server network interface connected to the rig (find it with `ip addr`)
WOL_INTERFACE=eth0
# GPU Index (0 = first GPU)
GPU_DEVICE_ID=0
# Path to the miner executable (BitCrack/VanitySearch)
MINER_BINARY=./vanitysearch
# Text the miner prints when a range is fully searched. Only change this if you
# use something other than VanitySearch.
MINER_DONE_MARKER=Range search completed

# THERMAL WATCHDOG & HARDWARE SETTINGS
# Set to 'true' to allow scripts to control fan speed/power limits (Linux/Nvidia only)
CONFIGURE_HARDWARE=false
FAN_SPEED=85
POWER_LIMIT=240

# PUZZLE CONFIGURATION
# Target Address (Default is Puzzle #71)
TARGET_ADDRESS=1PWo3JeB9jrGwfHDNpdGK54CRas7fsVzXU

# ALERTS (TELEGRAM)
# Get these from @BotFather and @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: CallMeBot username (with the @) for phone call when key's found
CALLMEBOT_USER=

# FILE PATHS (Optional Overrides)
# Leave these blank to default to the current directory (or to /mnt/usb_storage,
# if an existing database is already there)
# Example: /mnt/usb_storage/mining.db
DB_PATH=
WINNER_PATH=
STATE_FILE=

# PORTFOLIO STATUS PUSH (Optional)
# If set, the orchestrator POSTs raw chunk-completion status after each submitted job.
PORTFOLIO_STATUS_URL=
PORTFOLIO_STATUS_TOKEN=
